{
  "openapi": "3.0.3",
  "info": { "title": "CHIRA OS Guardian", "version": "0.1.0" },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      },
      "association": {
        "type": "apiKey",
        "in": "header",
        "name": "x-association-id"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/auth/{*}": {
      "get": {
        "parameters": [
          {
            "schema": { "type": "string" },
            "in": "path",
            "name": "*",
            "required": true
          }
        ],
        "responses": { "200": { "description": "Default Response" } }
      },
      "post": {
        "parameters": [
          {
            "schema": { "type": "string" },
            "in": "path",
            "name": "*",
            "required": true
          }
        ],
        "responses": { "200": { "description": "Default Response" } }
      }
    },
    "/health/live": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "enum": ["ok"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/session": {
      "get": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/parcels": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "producerName",
                      "crop",
                      "hectares",
                      "location",
                      "assignedTo"
                    ],
                    "properties": {
                      "id": { "format": "uuid", "type": "string" },
                      "name": {
                        "minLength": 1,
                        "maxLength": 100,
                        "type": "string"
                      },
                      "producerName": {
                        "minLength": 1,
                        "maxLength": 100,
                        "type": "string"
                      },
                      "crop": {
                        "minLength": 1,
                        "maxLength": 100,
                        "type": "string"
                      },
                      "hectares": {
                        "exclusiveMinimum": 0,
                        "maximum": 10000,
                        "type": "number"
                      },
                      "location": {
                        "type": "object",
                        "required": ["type", "coordinates"],
                        "properties": {
                          "type": { "type": "string", "enum": ["Point"] },
                          "coordinates": {
                            "type": "array",
                            "items": [
                              {
                                "minimum": -180,
                                "maximum": 180,
                                "type": "number"
                              },
                              {
                                "minimum": -90,
                                "maximum": 90,
                                "type": "number"
                              }
                            ],
                            "additionalItems": false,
                            "minItems": 2,
                            "maxItems": 2
                          }
                        }
                      },
                      "assignedTo": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "producerName",
                  "crop",
                  "hectares",
                  "location"
                ],
                "properties": {
                  "name": {
                    "minLength": 1,
                    "maxLength": 100,
                    "type": "string"
                  },
                  "producerName": {
                    "minLength": 1,
                    "maxLength": 100,
                    "type": "string"
                  },
                  "crop": {
                    "minLength": 1,
                    "maxLength": 100,
                    "type": "string"
                  },
                  "hectares": {
                    "exclusiveMinimum": 0,
                    "maximum": 10000,
                    "type": "number"
                  },
                  "location": {
                    "type": "object",
                    "required": ["type", "coordinates"],
                    "properties": {
                      "type": { "type": "string", "enum": ["Point"] },
                      "coordinates": {
                        "type": "array",
                        "items": [
                          { "minimum": -180, "maximum": 180, "type": "number" },
                          { "minimum": -90, "maximum": 90, "type": "number" }
                        ],
                        "additionalItems": false,
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "producerName",
                    "crop",
                    "hectares",
                    "location",
                    "assignedTo"
                  ],
                  "properties": {
                    "id": { "format": "uuid", "type": "string" },
                    "name": {
                      "minLength": 1,
                      "maxLength": 100,
                      "type": "string"
                    },
                    "producerName": {
                      "minLength": 1,
                      "maxLength": 100,
                      "type": "string"
                    },
                    "crop": {
                      "minLength": 1,
                      "maxLength": 100,
                      "type": "string"
                    },
                    "hectares": {
                      "exclusiveMinimum": 0,
                      "maximum": 10000,
                      "type": "number"
                    },
                    "location": {
                      "type": "object",
                      "required": ["type", "coordinates"],
                      "properties": {
                        "type": { "type": "string", "enum": ["Point"] },
                        "coordinates": {
                          "type": "array",
                          "items": [
                            {
                              "minimum": -180,
                              "maximum": 180,
                              "type": "number"
                            },
                            { "minimum": -90, "maximum": 90, "type": "number" }
                          ],
                          "additionalItems": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      }
                    },
                    "assignedTo": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/inspections": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id",
                      "parcelId",
                      "authorId",
                      "notes",
                      "biosecurity",
                      "photoIds",
                      "status",
                      "version",
                      "observedAt"
                    ],
                    "properties": {
                      "id": { "format": "uuid", "type": "string" },
                      "parcelId": { "format": "uuid", "type": "string" },
                      "authorId": { "type": "string" },
                      "notes": {
                        "minLength": 1,
                        "maxLength": 5000,
                        "type": "string"
                      },
                      "biosecurity": { "type": "boolean" },
                      "photoIds": {
                        "maxItems": 5,
                        "uniqueItems": true,
                        "type": "array",
                        "items": { "format": "uuid", "type": "string" }
                      },
                      "status": {
                        "anyOf": [
                          { "type": "string", "enum": ["draft"] },
                          { "type": "string", "enum": ["submitted"] },
                          { "type": "string", "enum": ["reviewed"] }
                        ]
                      },
                      "version": { "minimum": 1, "type": "integer" },
                      "observedAt": { "format": "date-time", "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/inspections/{id}": {
      "put": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "parcelId",
                  "authorId",
                  "notes",
                  "biosecurity",
                  "photoIds",
                  "observedAt",
                  "operationId",
                  "expectedVersion"
                ],
                "properties": {
                  "parcelId": { "format": "uuid", "type": "string" },
                  "authorId": { "type": "string" },
                  "notes": {
                    "minLength": 1,
                    "maxLength": 5000,
                    "type": "string"
                  },
                  "biosecurity": { "type": "boolean" },
                  "photoIds": {
                    "maxItems": 5,
                    "uniqueItems": true,
                    "type": "array",
                    "items": { "format": "uuid", "type": "string" }
                  },
                  "observedAt": { "format": "date-time", "type": "string" },
                  "operationId": { "format": "uuid", "type": "string" },
                  "expectedVersion": { "minimum": 0, "type": "integer" }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "id",
                    "parcelId",
                    "authorId",
                    "notes",
                    "biosecurity",
                    "photoIds",
                    "status",
                    "version",
                    "observedAt"
                  ],
                  "properties": {
                    "id": { "format": "uuid", "type": "string" },
                    "parcelId": { "format": "uuid", "type": "string" },
                    "authorId": { "type": "string" },
                    "notes": {
                      "minLength": 1,
                      "maxLength": 5000,
                      "type": "string"
                    },
                    "biosecurity": { "type": "boolean" },
                    "photoIds": {
                      "maxItems": 5,
                      "uniqueItems": true,
                      "type": "array",
                      "items": { "format": "uuid", "type": "string" }
                    },
                    "status": {
                      "anyOf": [
                        { "type": "string", "enum": ["draft"] },
                        { "type": "string", "enum": ["submitted"] },
                        { "type": "string", "enum": ["reviewed"] }
                      ]
                    },
                    "version": { "minimum": 1, "type": "integer" },
                    "observedAt": { "format": "date-time", "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/inspections/{id}/submit": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": ["operationId", "expectedVersion"],
                "properties": {
                  "operationId": { "format": "uuid", "type": "string" },
                  "expectedVersion": { "minimum": 0, "type": "integer" }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "id",
                    "parcelId",
                    "authorId",
                    "notes",
                    "biosecurity",
                    "photoIds",
                    "status",
                    "version",
                    "observedAt"
                  ],
                  "properties": {
                    "id": { "format": "uuid", "type": "string" },
                    "parcelId": { "format": "uuid", "type": "string" },
                    "authorId": { "type": "string" },
                    "notes": {
                      "minLength": 1,
                      "maxLength": 5000,
                      "type": "string"
                    },
                    "biosecurity": { "type": "boolean" },
                    "photoIds": {
                      "maxItems": 5,
                      "uniqueItems": true,
                      "type": "array",
                      "items": { "format": "uuid", "type": "string" }
                    },
                    "status": {
                      "anyOf": [
                        { "type": "string", "enum": ["draft"] },
                        { "type": "string", "enum": ["submitted"] },
                        { "type": "string", "enum": ["reviewed"] }
                      ]
                    },
                    "version": { "minimum": 1, "type": "integer" },
                    "observedAt": { "format": "date-time", "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/inspections/{id}/reviews": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "operationId",
                  "expectedVersion",
                  "notes",
                  "followUp"
                ],
                "properties": {
                  "operationId": { "format": "uuid", "type": "string" },
                  "expectedVersion": { "minimum": 1, "type": "integer" },
                  "notes": {
                    "minLength": 1,
                    "maxLength": 5000,
                    "type": "string"
                  },
                  "followUp": { "type": "boolean" }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "id",
                    "parcelId",
                    "authorId",
                    "notes",
                    "biosecurity",
                    "photoIds",
                    "status",
                    "version",
                    "observedAt"
                  ],
                  "properties": {
                    "id": { "format": "uuid", "type": "string" },
                    "parcelId": { "format": "uuid", "type": "string" },
                    "authorId": { "type": "string" },
                    "notes": {
                      "minLength": 1,
                      "maxLength": 5000,
                      "type": "string"
                    },
                    "biosecurity": { "type": "boolean" },
                    "photoIds": {
                      "maxItems": 5,
                      "uniqueItems": true,
                      "type": "array",
                      "items": { "format": "uuid", "type": "string" }
                    },
                    "status": {
                      "anyOf": [
                        { "type": "string", "enum": ["draft"] },
                        { "type": "string", "enum": ["submitted"] },
                        { "type": "string", "enum": ["reviewed"] }
                      ]
                    },
                    "version": { "minimum": 1, "type": "integer" },
                    "observedAt": { "format": "date-time", "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/inspections/{id}/photos/{photoId}": {
      "put": {
        "parameters": [
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "id",
            "required": true
          },
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "photoId",
            "required": true
          }
        ],
        "responses": { "200": { "description": "Default Response" } }
      }
    },
    "/api/v1/photos/{id}": {
      "get": {
        "parameters": [
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": { "200": { "description": "Default Response" } }
      }
    },
    "/api/v1/reviews": {
      "get": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/exports/parcels.geojson": {
      "get": { "responses": { "200": { "description": "Default Response" } } }
    },
    "/api/v1/exports/inspections.csv": {
      "get": { "responses": { "200": { "description": "Default Response" } } }
    }
  },
  "security": [{ "session": [], "association": [] }]
}
