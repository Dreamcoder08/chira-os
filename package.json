{
  "name": "chira-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch --env-file=.env apps/api/src/main.ts",
    "dev:web": "vite apps/web --host 127.0.0.1",
    "worker": "tsx --env-file=.env apps/worker/src/main.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "build": "vite build apps/web",
    "start": "tsx --env-file=.env apps/api/src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && depcruise --config .dependency-cruiser.cjs packages apps/api/src apps/worker/src apps/web/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "test:e2e": "playwright test",
    "pilot:check": "tsx scripts/pilot-check.ts",
    "user:create": "tsx --env-file=.env scripts/user-create.ts",
    "contracts": "tsx scripts/openapi.ts && openapi-typescript docs/api/openapi.json -o packages/contracts/src/api.d.ts",
    "security:deps": "pnpm audit --audit-level=high",
    "sbom": "pnpm sbom --sbom-format cyclonedx --out .local/sbom.cdx.json",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "setup:local": "tsx scripts/setup-local.ts",
    "backup": "tsx --env-file=.env scripts/backup.ts",
    "restore:check": "tsx --env-file=.env scripts/restore-check.ts",
    "diagrams:setup": "tsx scripts/archify-setup.ts",
    "diagrams:build": "tsx scripts/diagrams.ts",
    "security:scan": "bash scripts/security-scan.sh fs",
    "security:image": "bash scripts/security-scan.sh image",
    "security:database": "bash scripts/security-scan.sh database",
    "publish:repo": "bash scripts/publish-repo.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.104.5",
    "better-auth": "1.7.12",
    "dexie": "4.4.7",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "maplibre-gl": "6.15.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
